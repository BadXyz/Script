local function autoSellLoop()
    while task.wait(CONFIG.sellInterval) do
        if STATE.sell then
            local hrp = getHRP()
            if hrp then
                local sellPad = nil
                local shops = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Shops")
                if shops then
                    local sellShop = shops:FindFirstChild("SellShop")
                    if sellShop then
                        sellPad = sellShop:FindFirstChild("SellCircle")
                    end
                end
                
                if sellPad then
                    local oldCFrame = hrp.CFrame
                    hrp.CFrame = sellPad.CFrame + Vector3.new(0, 3, 0)
                    task.wait(0.5)
                    firetouchinterest(hrp, sellPad, 0)
                    task.wait(0.1)
                    firetouchinterest(hrp, sellPad, 1)
                    task.wait(1.5)
                    hrp.CFrame = oldCFrame
                end
            end
        end
    end
end
